<mxfile host="app.diagrams.net"><diagram id="st3d" name="ST3D"><mxGraphModel grid="1" pageWidth="1440" pageHeight="650"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="note0" parent="1" vertex="1" value="ST3D 单目羽毛球三维轨迹重建" style="text;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=30;"><mxGeometry x="30" y="24" width="432.0" height="42.0" as="geometry" /></mxCell><mxCell id="note1" parent="1" vertex="1" value="主网络推理" style="text;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=23;"><mxGeometry x="30" y="73" width="130" height="32.199999999999996" as="geometry" /></mxCell><mxCell id="note2" parent="1" vertex="1" value="1,929,971 个参数" style="text;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=17;"><mxGeometry x="222" y="79" width="164.6" height="23.799999999999997" as="geometry" /></mxCell><mxCell id="note3" parent="1" vertex="1" value="共享权重的空间修正网络" style="text;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=23;"><mxGeometry x="30" y="346" width="268" height="32.199999999999996" as="geometry" /></mxCell><mxCell id="note4" parent="1" vertex="1" value="14,888 个参数" style="text;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=17;"><mxGeometry x="382" y="352" width="135.01999999999998" height="23.799999999999997" as="geometry" /></mxCell><mxCell id="note5" parent="1" vertex="1" value="每帧 192 维 · 每层 6 个注意力头" style="text;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=17;"><mxGeometry x="648" y="265" width="300.6" height="23.799999999999997" as="geometry" /></mxCell><mxCell id="note6" parent="1" vertex="1" value="以主网络输出 X₀ 为起点，每轮根据当前轨迹重新计算投影偏差。" style="text;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=18;"><mxGeometry x="30" y="394" width="550.3199999999999" height="25.2" as="geometry" /></mxCell><mxCell id="note7" parent="1" vertex="1" value="同一组权重迭代 5 轮 · 输出 X₅" style="text;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=20;"><mxGeometry x="495" y="584" width="336.20000000000005" height="28.0" as="geometry" /></mxCell><mxCell id="note8" parent="1" vertex="1" value="T 为整回合帧数。网络对每帧输出一个球场坐标 (X, Y, Z)，单位为米。" style="text;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=16;"><mxGeometry x="30" y="623" width="542.3599999999999" height="22.4" as="geometry" /></mxCell><mxCell id="input0" parent="1" vertex="1" value="球心、13 个场地点与时间" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#f6f8fa;strokeColor=#9cabb4;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="30" y="124" width="269" height="40" as="geometry" /></mxCell><mxCell id="encode0" parent="1" vertex="1" value="坐标编码" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#e8f2fa;strokeColor=#6385a0;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="348" y="124" width="150" height="40" as="geometry" /></mxCell><mxCell id="input1" parent="1" vertex="1" value="灰度小图 + 热图 · 2 × 24 × 24" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#f6f8fa;strokeColor=#9cabb4;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="30" y="184" width="269" height="40" as="geometry" /></mxCell><mxCell id="encode1" parent="1" vertex="1" value="三层二维卷积" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#e8f2fa;strokeColor=#6385a0;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="348" y="184" width="150" height="40" as="geometry" /></mxCell><mxCell id="input2" parent="1" vertex="1" value="裁剪中心与尺度 · 3 维" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#f6f8fa;strokeColor=#9cabb4;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="30" y="244" width="269" height="40" as="geometry" /></mxCell><mxCell id="encode2" parent="1" vertex="1" value="线性映射" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#e8f2fa;strokeColor=#6385a0;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="348" y="244" width="150" height="40" as="geometry" /></mxCell><mxCell id="sum" parent="1" vertex="1" value="+" style="ellipse;whiteSpace=wrap;html=0;fillColor=#fff;strokeColor=#617782;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="553" y="185" width="38" height="38" as="geometry" /></mxCell><mxCell id="local" parent="1" vertex="1" value="局部注意力 × 2&#10;192 帧窗口" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#dceee8;strokeColor=#568e85;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="645" y="164" width="208" height="80" as="geometry" /></mxCell><mxCell id="global" parent="1" vertex="1" value="全局注意力 × 2&#10;整回合上下文" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#dceee8;strokeColor=#568e85;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="908" y="164" width="187" height="80" as="geometry" /></mxCell><mxCell id="initial" parent="1" vertex="1" value="逐帧位置回归&#10;三维初值 X₀ · T × 3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#dfedf7;strokeColor=#698aa4;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="1155" y="164" width="235" height="80" as="geometry" /></mxCell><mxCell id="resid" parent="1" vertex="1" value="三维轨迹投回相机&#10;检测球点 − 投影球点" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#edf0fa;strokeColor=#8e99b5;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="30" y="445" width="252" height="74" as="geometry" /></mxCell><mxCell id="embed" parent="1" vertex="1" value="31 维观测与运动特征&#10;线性映射 → 32 维" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#edf0fa;strokeColor=#8e99b5;fontSize=17;fontColor=#203b49;fontFamily=Microsoft YaHei;"><mxGeometry x="330" y="445" width="198" height="74" as="geometry" /></mxCell><mxCell id="conv" parent="1" vertex="1" va